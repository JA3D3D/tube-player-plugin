<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>AbletonAi</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check><allowed-os-versions><os-version min="11.0"/></allowed-os-versions></volume-check>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="helper"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plug-in" description="AbletonAi.vst3, in /Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.bassbible.abletonai.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plug-in" description="AbletonAi.component, in /Library/Audio/Plug-Ins/Components">
        <pkg-ref id="com.bassbible.abletonai.au"/>
    </choice>
    <choice id="helper" title="Live helper" description="Lets AbletonAi build in your Live set. Copied into your User Library's Remote Scripts folder.">
        <pkg-ref id="com.bassbible.abletonai.helper"/>
    </choice>
    <pkg-ref id="com.bassbible.abletonai.vst3" version="__VERSION__" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.bassbible.abletonai.au" version="__VERSION__" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.bassbible.abletonai.helper" version="__VERSION__" onConclusion="none">helper.pkg</pkg-ref>
</installer-gui-script>
